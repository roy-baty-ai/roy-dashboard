rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin() {
   let a=request.auth; let t=a == null ? {} : a.token;
   return a != null && a.uid == 'atmDvobZO2U0T5VKrsAe69tEkdt1'
    && t.email == 'roy.lab.20261001@gmail.com'
    && t.firebase.sign_in_provider == 'google.com'
    && t.email_verified == true
    && get(/databases/$(database)/documents/admins/$(a.uid)).data.enabled == true;
  }
  function spaceOK(space) { return space in ['real','synthetic']; }
  function active(space) { return get(/databases/$(database)/documents/privateRoy/$(space)/control/state).data.mode == 'active'; }
  function sourceAllowed(space) { let c=get(/databases/$(database)/documents/privateRoy/$(space)/control/state).data; return c.mode == 'active' && c.allowSourceIngest == true; }
  function hash(v) { return v is string && v.matches('^[0-9a-f]{64}$'); }
  function id(v) { return v is string && v.matches('^roy-web-[0-9]{4}$'); }
  function validCalendar(s) {
   let year=int(s[0:4]); let month=int(s[5:7]); let day=int(s[8:10]);
   let leap=year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
   let maxDay=month == 2 ? (leap ? 29 : 28) : (month in [4,6,9,11] ? 30 : 31);
   return year >= 1 && day <= maxDay;
  }
  function validCheckedAt(s) {
   return s is string && s.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]{1,3})?(Z|[+-](0[0-9]|1[0-3]):[0-5][0-9]|[+-]14:00)$')
    && !s.matches('.*-00:00$') && validCalendar(s);
  }
  function validPreview(s) {
   return s is string && s.size() <= 2048 && s.matches('^https://([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?[.])+[A-Za-z]{2,63}(:443)?([/?#]([A-Za-z0-9._~!$&()*+,;=:@/?#-]|%[0-9A-Fa-f]{2})*)?$');
  }
  function ready(p) { return validPreview(p.preview_url) && validCheckedAt(p.last_checked_at); }
  function checks(m) {
   return m is map && (m.size() == 0 || ( m.keys().hasOnly(['anonymous_reload','gmail_current_history','send_reconciliation','public_preview','visual_qa','sales_screenshot','current_source_contact','bounded_contact_policy_review'])
    && m.get('anonymous_reload',false) is bool && m.get('gmail_current_history',false) is bool
    && m.get('send_reconciliation',false) is bool && m.get('public_preview',false) is bool
    && m.get('visual_qa',false) is bool && m.get('sales_screenshot',false) is bool
    && m.get('current_source_contact',false) is bool && m.get('bounded_contact_policy_review',false) is bool));
  }
  function gateShape(g) {
   return g is map && g.keys().hasOnly(['code','label','evidence'])
    && g.code is string && g.code.matches('^[a-z][a-z0-9_]{0,63}$')
    && g.label is string && g.label.size() > 0 && g.label.size() <= 500
    && g.get('evidence','') is string && g.get('evidence','').size() <= 4000;
  }




  function payload(p,caseId) {
   let name=p.business_name; let revenue=p.confirmed_revenue_usd; let next=p.next_action; let note=p.internal_note; let url=p.preview_url; let status=p.status; let sent=p.sent;
   let c=p.confirmed_gates; let m=p.missing_gates; let r=p.restrictions;
   return p is map && p.keys().size() <= 32 && p.id == caseId && id(caseId)
    && name is string && name.size() > 0 && name.size() <= 200
    && (revenue == null || (revenue is number && revenue >= 0 && revenue <= 1000000000))
    && sent is bool && status in ['NOT_READY','READY_FOR_HUMAN_GO','SENT_WAITING'] && p.readiness == status
    && sent == (status == 'SENT_WAITING')
    && (sent ? (p.sent_evidence is map && (p.email.sent_at == null || (p.email.sent_at is string && p.email.sent_at.size() > 0))) : p.sent_evidence == null)
    && c is list && c.size() <= 32
    && m is list && m.size() <= 16
    && r is list && r.size() <= 32
    && next is string && next.size() <= 4000 && note is string && note.size() <= 4000
    && (url == null || validPreview(url))
    && checks(p.gate_checks) && (status != 'READY_FOR_HUMAN_GO' || ready(p));
  }
  function record(d,caseId) {
   let s=d.source;
   return d.keys().hasAll(['schemaVersion','revision','source','sourceData','payload','changeKind','operationId','updatedBy','updatedAt'])
    && d.keys().hasOnly(['schemaVersion','revision','source','sourceData','payload','changeKind','operationId','updatedBy','updatedAt'])
    && d.schemaVersion == 2 && d.revision is int && d.revision > 0 && d.revision <= 1000000
    && s.keys().hasOnly(['repo','commit','path','key','version','hash','intakeId'])
    && s.repo == 'roy-baty-ai/roy-lab' && s.commit.matches('^[0-9a-f]{40}$')
    && s.path in ['business/outbound.json','knowledge/ROY_CURRENT_STATE.md']
    && s.key is string && s.key.size() > 0 && s.key.size() <= 300
    && s.version is int && s.version > 0 && hash(s.hash) && hash(s.intakeId)
    && hash(d.operationId) && d.changeKind in ['source','manual']
    && payload(d.payload,caseId) && d.sourceData is map
    && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
  }
  function receiptMatches(space,caseId,d) {
   let s=d.source;
   let m=getAfter(/databases/$(database)/documents/privateRoy/$(space)/intakes/$(s.intakeId)).data;
   let e=m.entries[caseId];
   return m.sourceCommit == s.commit && e.sourceVersion == s.version && e.sourceHash == s.hash
    && e.sourcePath == s.path && e.sourceKey == s.key && e.expectedRevision == d.revision - 1;
  }
  function historyMatches(space,caseId,d) {
   return getAfter(/databases/$(database)/documents/privateRoy/$(space)/cases/$(caseId)/history/$(string(d.revision))).data.record == d;
  }
  function sourceShape(space,caseId,d) {
   let s=d.source; let p=d.payload; let o=d.sourceData;
   return d.changeKind == 'source' && d.operationId == s.intakeId && sourceAllowed(space)
    && p.diff(o).affectedKeys().hasOnly(['internal_note'])
    && o.internal_note is string && o.internal_note.size() <= 4000
    && p.status != 'READY_FOR_HUMAN_GO' && p.gate_checks.size() == 0
    && o.status != 'READY_FOR_HUMAN_GO' && o.gate_checks.size() == 0
    && receiptMatches(space,caseId,d)
    && caseId in getAfter(/databases/$(database)/documents/privateRoy/$(space)/registry/current).data.caseIds;
  }
  function preserveSent(a,b) { return !a.sent || (b.sent && b.sent_evidence == a.sent_evidence && b.email == a.email && b.offer == a.offer); }
  function manual(a,b) {
   return b.changeKind == 'manual' && b.source == a.source && b.sourceData == a.sourceData
    && b.payload.diff(a.payload).affectedKeys().hasOnly(['next_action','internal_note','status','readiness','gate_checks','last_checked_at'])
    && preserveSent(a.payload,b.payload) && b.operationId != a.operationId;
  }
  // Source intake alone can fill an explicitly unknown timestamp once. Calendar
  // validity is checked by the intake client; Rules retain a bounded ISO shape.
  function sourceEmailPreserved(a,b) {
   return a.sent_at == null && a.get('sent_at_precision',null) == null
    && b.diff(a).affectedKeys().hasOnly(['sent_at','sent_at_precision'])
    && b.get('sent_at_precision',null) in [null,'second','minute']
    && b.sent_at is string && b.sent_at.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}([.][0-9]{1,3})?)?(Z|[+-][0-9]{2}:[0-9]{2})$');
  }
  function preserveSentSource(a,b) { return !a.sent || (b.sent && b.sent_evidence == a.sent_evidence && (b.email == a.email || sourceEmailPreserved(a.email,b.email)) && b.offer == a.offer); }
  function sourceUpdate(space,caseId,a,b) {
   return sourceShape(space,caseId,b) && b.source.version == a.source.version+1
    && b.payload.internal_note == a.payload.internal_note && preserveSentSource(a.payload,b.payload)
    && b.payload.restrictions.hasAll(a.payload.restrictions)
    && b.payload.confirmed_gates.hasAll(a.payload.confirmed_gates);
  }

  // Parts and certificates are immutable. A case can only use fully validated evidence.
  function partCodes(g) {
   return g.size() == 0 ? [] : g.size() == 1 ? [g[0].code] : g.size() == 2 ? [g[0].code,g[1].code] : g.size() == 3 ? [g[0].code,g[1].code,g[2].code] : [g[0].code,g[1].code,g[2].code,g[3].code];
  }
  function smallGates(g) {
   return (g.size() < 1 || gateShape(g[0])) && (g.size() < 2 || gateShape(g[1]))
    && (g.size() < 3 || gateShape(g[2])) && (g.size() < 4 || gateShape(g[3]));
  }
  function restriction(v) { return v is string && v.size() > 0 && v.size() <= 2000; }
  function part(d) {
   let c=d.confirmed; let m=d.missing; let r=d.restrictions;
   return d.keys().hasOnly(['confirmed','missing','restrictions','confirmedCodes','missingCodes'])
    && c is list && c.size() <= 4 && m is list && m.size() <= 2 && r is list && r.size() <= 4
    && smallGates(c) && smallGates(m)
    && (r.size() < 1 || restriction(r[0])) && (r.size() < 2 || restriction(r[1]))
    && (r.size() < 3 || restriction(r[2])) && (r.size() < 4 || restriction(r[3]))
    && d.confirmedCodes == partCodes(c) && d.missingCodes == partCodes(m);
  }
  function checkedCodes(m) {
   return [
    m.get('anonymous_reload',false) ? 'anonymous_reload' : '',
    m.get('gmail_current_history',false) ? 'gmail_current_history' : '',
    m.get('send_reconciliation',false) ? 'send_reconciliation' : '',
    m.get('public_preview',false) ? 'public_preview' : '',
    m.get('visual_qa',false) ? 'visual_qa' : '',
    m.get('sales_screenshot',false) ? 'sales_screenshot' : '',
    m.get('current_source_contact',false) ? 'current_source_contact' : '',
    m.get('bounded_contact_policy_review',false) ? 'bounded_contact_policy_review' : ''
   ].removeAll(['']);
  }
  function evidence(space,caseId,d) {
   let e=get(/databases/$(database)/documents/privateRoy/$(space)/validation/$(d.source.intakeId)/cases/$(caseId)).data;
   let p=d.payload;
   return p.confirmed_gates == e.confirmed && p.missing_gates == e.missing && p.restrictions == e.restrictions
    && (p.status != 'READY_FOR_HUMAN_GO' || e.missingCodes.removeAll(['initial_send_go']).hasOnly(checkedCodes(p.gate_checks)));
  }

  function numericPublic(d) {
   return d.keys().hasOnly(['caseCount','readyCount','preparingCount','sentCount','previewCount','confirmedRevenueUsd','targetCount','revision','updatedAt'])
    && d.caseCount is int && d.caseCount >= 0 && d.caseCount <= 50
    && d.readyCount is int && d.readyCount >= 0 && d.preparingCount is int && d.preparingCount >= 0
    && d.sentCount is int && d.sentCount >= 0 && d.caseCount == d.readyCount+d.preparingCount+d.sentCount
    && d.previewCount is int && d.previewCount >= 0 && d.previewCount <= d.caseCount
    && d.confirmedRevenueUsd is number && d.confirmedRevenueUsd >= 0 && d.targetCount == 10
    && d.revision is int && d.revision > 0 && d.updatedAt is timestamp;
  }
  match /admins/{uid} { allow get: if request.auth != null && request.auth.uid == uid; allow list, write: if false; }
  // Old storage remains read-only during cutover. Never overwrite or import into it.
  match /control/source { allow get: if admin(); allow list, write: if false; }
  match /privatePipeline/current { allow get: if admin(); allow list, write: if false; }
  match /publicSummary/current { allow get: if numericPublic(resource.data); allow list, write: if false; }
  match /privateRoy/{space}/control/state { allow get: if spaceOK(space) && admin(); allow list, write: if false; }
  match /privateRoy/{space}/registry/current {
   allow get: if spaceOK(space) && admin();
   function shape() { let d=request.resource.data; return d.keys().hasOnly(['caseIds','revision','intakeId','updatedBy','updatedAt'])
    && d.caseIds is list && d.caseIds.size() <= 50 && d.caseIds.toSet().size() == d.caseIds.size()
    && d.revision is int && hash(d.intakeId) && d.updatedBy == request.auth.uid && d.updatedAt == request.time; }
   function added() { let d=request.resource.data;let m=getAfter(/databases/$(database)/documents/privateRoy/$(space)/intakes/$(d.intakeId)).data;
    return d.caseIds.toSet().difference(resource.data.caseIds.toSet()).hasOnly(m.entries.keys()); }
   allow create: if spaceOK(space) && admin() && sourceAllowed(space) && shape() && request.resource.data.revision == 1
    && request.resource.data.caseIds.toSet().hasOnly(getAfter(/databases/$(database)/documents/privateRoy/$(space)/intakes/$(request.resource.data.intakeId)).data.entries.keys());
   allow update: if spaceOK(space) && admin() && sourceAllowed(space) && shape() && request.resource.data.revision == resource.data.revision+1
    && request.resource.data.caseIds.hasAll(resource.data.caseIds) && added();
   allow list, delete: if false;
  }
  match /privateRoy/{space}/intakes/{intakeId} {
   allow get: if spaceOK(space) && admin();
   allow create: if spaceOK(space) && admin() && sourceAllowed(space) && hash(intakeId)
    && request.resource.data.keys().hasOnly(['schemaVersion','space','sourceRepo','sourceCommit','finalization','entries'])
    && request.resource.data.schemaVersion == 1 && request.resource.data.space == space
    && request.resource.data.sourceRepo == 'roy-baty-ai/roy-lab' && request.resource.data.sourceCommit.matches('^[0-9a-f]{40}$')
    && request.resource.data.finalization.keys().hasOnly(['state','actor','evidence'])
    && request.resource.data.finalization.state == 'finalized' && request.resource.data.finalization.actor == 'Roy'
    && request.resource.data.finalization.evidence is string && request.resource.data.finalization.evidence.size() >= 8 && request.resource.data.finalization.evidence.size() <= 2000
    && request.resource.data.entries is map && request.resource.data.entries.size() >= 1 && request.resource.data.entries.size() <= 10;
   allow list, update, delete: if false;
  }
  match /privateRoy/{space}/cases/{caseId} {
   allow get: if spaceOK(space) && admin();
   function createCase(d) {
    return d.revision == 1 && d.source.version == 1 && sourceShape(space,caseId,d)
     && record(d,caseId) && evidence(space,caseId,d) && historyMatches(space,caseId,d);
   }
   function updateCase(a,b) {
    return b.revision == a.revision+1
     && (b.changeKind == 'manual' ? manual(a,b) : sourceUpdate(space,caseId,a,b))
     && record(b,caseId) && evidence(space,caseId,b) && historyMatches(space,caseId,b);
   }
   allow create: if spaceOK(space) && admin() && createCase(request.resource.data);
   allow update: if spaceOK(space) && admin() && active(space)
    && (resource != null ? updateCase(resource.data,request.resource.data) : false);
   allow list, delete: if false;
   match /history/{revision} {
    allow get: if spaceOK(space) && admin();
    allow create: if spaceOK(space) && admin() && active(space)
     && request.resource.data.keys().hasOnly(['record']) && revision == string(request.resource.data.record.revision)
     && request.resource.data.record.get('updatedAt',null) == request.time
     && getAfter(/databases/$(database)/documents/privateRoy/$(space)/cases/$(caseId)).data == request.resource.data.record;
    allow list, update, delete: if false;
   }
  }

  match /privateRoy/{space}/validation/{intakeId}/cases/{caseId} {
   allow get: if spaceOK(space) && admin();
   function assembled(d) {
    let v0=get(/databases/$(database)/documents/privateRoy/$(space)/validation/$(intakeId)/cases/$(caseId)/parts/0).data;
    let v1=get(/databases/$(database)/documents/privateRoy/$(space)/validation/$(intakeId)/cases/$(caseId)/parts/1).data;
    let v2=get(/databases/$(database)/documents/privateRoy/$(space)/validation/$(intakeId)/cases/$(caseId)/parts/2).data;
    let v3=get(/databases/$(database)/documents/privateRoy/$(space)/validation/$(intakeId)/cases/$(caseId)/parts/3).data;
    let v4=get(/databases/$(database)/documents/privateRoy/$(space)/validation/$(intakeId)/cases/$(caseId)/parts/4).data;
    let v5=get(/databases/$(database)/documents/privateRoy/$(space)/validation/$(intakeId)/cases/$(caseId)/parts/5).data;
    let v6=get(/databases/$(database)/documents/privateRoy/$(space)/validation/$(intakeId)/cases/$(caseId)/parts/6).data;
    let v7=get(/databases/$(database)/documents/privateRoy/$(space)/validation/$(intakeId)/cases/$(caseId)/parts/7).data;
    return d.keys().hasOnly(['confirmed','missing','restrictions','confirmedCodes','missingCodes'])
     && d.confirmed == v0.confirmed.concat(v1.confirmed).concat(v2.confirmed).concat(v3.confirmed).concat(v4.confirmed).concat(v5.confirmed).concat(v6.confirmed).concat(v7.confirmed)
     && d.missing == v0.missing.concat(v1.missing).concat(v2.missing).concat(v3.missing).concat(v4.missing).concat(v5.missing).concat(v6.missing).concat(v7.missing)
     && d.restrictions == v0.restrictions.concat(v1.restrictions).concat(v2.restrictions).concat(v3.restrictions).concat(v4.restrictions).concat(v5.restrictions).concat(v6.restrictions).concat(v7.restrictions)
     && d.confirmedCodes == v0.confirmedCodes.concat(v1.confirmedCodes).concat(v2.confirmedCodes).concat(v3.confirmedCodes).concat(v4.confirmedCodes).concat(v5.confirmedCodes).concat(v6.confirmedCodes).concat(v7.confirmedCodes)
     && d.missingCodes == v0.missingCodes.concat(v1.missingCodes).concat(v2.missingCodes).concat(v3.missingCodes).concat(v4.missingCodes).concat(v5.missingCodes).concat(v6.missingCodes).concat(v7.missingCodes)
     && d.confirmedCodes.toSet().size() == d.confirmedCodes.size()
     && d.missingCodes.toSet().size() == d.missingCodes.size()
     && !d.confirmedCodes.hasAny(d.missingCodes)
     && d.missingCodes.hasOnly(['anonymous_reload','gmail_current_history','send_reconciliation','public_preview','visual_qa','sales_screenshot','current_source_contact','bounded_contact_policy_review','initial_send_go']);
   }
   allow create: if spaceOK(space) && admin() && sourceAllowed(space) && hash(intakeId) && id(caseId) && assembled(request.resource.data);
   allow list, update, delete: if false;
   match /parts/{partId} {
    allow get: if spaceOK(space) && admin();
    allow create: if spaceOK(space) && admin() && sourceAllowed(space) && hash(intakeId) && id(caseId)
     && partId in ['0','1','2','3','4','5','6','7'] && part(request.resource.data);
    allow list, update, delete: if false;
   }
  }

  match /{document=**} { allow read, write: if false; }
 }
}
